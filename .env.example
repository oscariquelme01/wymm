# =============================================================================
# Where Is My Money — Environment Template
# =============================================================================
# Copy this file to env/.env.dev (and optionally env/.env.prod) and fill in
# the values. All services (API, ML classifier, Docker, ngrok) read from
# these files. See the Makefile for available commands.
#
#   cp .env.example env/.env.dev
#   cp .env.example env/.env.prod
# =============================================================================

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_NAME=wymm
DB_PASSWORD=user
DB_USERNAME=user
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# ML Classifier
# -----------------------------------------------------------------------------
CLASSIFIER_URL=http://localhost:8000
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Enable Banking
# -----------------------------------------------------------------------------
ENABLE_BANKING_APP_ID=your-app-id-here
# Provide either the private key directly OR a path to the PEM file.
# The path is relative to /app/ inside the API container (the .pem must
# exist inside api-node/ so it gets copied into the image).
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=./your-app-id.pem
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_AUDIENCE=api.enablebanking.com
ENABLE_BANKING_REDIRECT_URL=

# -----------------------------------------------------------------------------
# Telegram Alerts (optional — leave empty to disable)
# -----------------------------------------------------------------------------
# 1. Create a bot via @BotFather on Telegram, copy the token
# 2. Send a message to the bot, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Ngrok (dev only — enables the OAuth redirect tunnel)
# -----------------------------------------------------------------------------
# Get yours at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken-here
