# Enable Banking configuration (required for the API)
ENABLE_BANKING_APP_ID=your-app-id-here
# Provide either the private key directly OR a path to the PEM file.
# The path is relative to /app/ inside the API container (the .pem must
# exist inside api-node/ so it gets copied into the image).
# Example: ./0524ce47-2889-4319-81e4-1b74d84f3ecc.pem
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=./0524ce47-2889-4319-81e4-1b74d84f3ecc.pem
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_AUDIENCE=api.enablebanking.com
ENABLE_BANKING_REDIRECT_URL=

# Frontend URL (used by API for CORS/redirects)
FRONTEND_URL=http://localhost:5173

# Anthropic API key (required for the ML classifier)
# Note: the env var name has a typo preserved from the original code
ANTRHOPIC_API_KEY=your-anthropic-api-key-here

# Ngrok auth token (required for dev -- enables the OAuth redirect tunnel)
# Get yours at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=39qIVELxNyRopdNYm3bdxKfPyyj_4fVaEycB6BZXtZjn7vjCC
